# Copy to .env and change the values. .env is git-ignored.
POSTGRES_PASSWORD=paypoint_local_password
# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
# Password for the demo users admin@paypoint.local and cajero@paypoint.local
DEMO_PASSWORD=paypoint-demo
# HMAC secret for the demo integrator (api key: pk_demo_tienda_centro)
DEMO_PARTNER_SECRET=demo-partner-secret-change-me
